# Copy this file to .env and fill in your values
# Never commit .env to git

# Required: your OpenAI API key
OPENAI_API_KEY=sk-...your-key-here...

# Optional: model to use (defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional: number of RAG chunks to retrieve (default: 4)
RAG_TOP_K=4

# Optional: show raw recent questions in the Analytics tab (default: false).
# The query log stores free-text questions; enable only for local curator use.
SHOW_RECENT_QUESTIONS=false
